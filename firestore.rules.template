rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function myEmail() { return request.auth.token.email.lower(); }
    function isOwner() { return signedIn() && myEmail() == 'OWNER_EMAIL'; }
    function isEditor() {
      let p = /databases/$(database)/documents/access/main;
      return signedIn() && exists(p) && myEmail() in get(p).data.editors;
    }
    // The list of people who can use the app: only the owner can change it.
    match /access/main {
      allow read: if isOwner() || isEditor();
      allow write: if isOwner();
    }
    // Roster, seating charts and attendance.
    match /ensemble/{document=**} {
      allow read, write: if isOwner() || isEditor();
    }
  }
}
